# Supabase project URL (found in Supabase Dashboard: Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable anonymous key (found in Supabase Dashboard: Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Feature flag: Set to 'true' to enable the Apple Sign-In button on supported iOS and web clients
VITE_ENABLE_APPLE_SIGNIN=false
