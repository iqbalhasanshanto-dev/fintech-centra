.dark .bg-brand-500,
.dark .btn-primary {
  background: #C6FF3D !important;
  color: #171717 !important;
}

.dark .bg-brand-600 *,
.dark .bg-brand-500 *,
.dark .btn-primary * {
  color: #171717 !important;
  stroke: #171717 !important;
}

.dark .text-brand-400,
.dark .text-brand-600 {
  color: #C6FF3D !important;
}

.dark .border-brand-500,
.dark .border-brand-400 {
  border-color: #C6FF3D !important;
}

/* Dark Active Nav Item Highlights */
.dark .bg-brand-950\/60,
.dark .bg-brand-50 {
  background-color: #C6FF3D !important;
  color: #171717 !important;
}

.dark .bg-brand-950\/60 *,
.dark .bg-brand-50 * {
  color: #171717 !important;
  stroke: #171717 !important;
}

.dark .border-brand-200\/70,
.dark .border-brand-900\/50 {
  border-color: #C6FF3D !important;
}

/* Custom transitions and scrollbar helpers */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Subtle modern scrollbar for desktop tables & drawers */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(115, 115, 115, 0.4);
  border-radius: 9999px;
}
.dark ::-webkit-scrollbar-thumb {
  background: rgba(64, 64, 64, 0.8);
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(115, 115, 115, 0.6);
}
.dark ::-webkit-scrollbar-thumb:hover {
  background: rgba(80, 80, 80, 1);
}

/* Smooth step transitions */
@keyframes slideLeftFade {
  0% {
    opacity: 0;
    transform: translateX(18px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideRightFade {
  0% {
    opacity: 0;
    transform: translateX(-18px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes fadeIn {
  0% {
    opacity: 0;
    transform: scale(0.98);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes bounceSubtle {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6px);
  }
}

.animate-slide-left-fade {
  animation: slideLeftFade 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.animate-slide-right-fade {
  animation: slideRightFade 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.animate-fade-in {
  animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.animate-bounce-subtle {
  animation: bounceSubtle 2.5s ease-in-out infinite;
}
