        <span className={`px-2 py-1 ${badgeBg} text-[10px] font-bold rounded-md tracking-wide`}>{badgeText}</span>
      </div>
      <div className="flex items-baseline gap-2">
        <span className="text-3xl font-bold text-white">{amount}</span>
      </div>
